{
  "name": "@tkwf/tsclient",
  "version": "1.0.9",
  "author": "LoongBa",
  "license": "MIT",
  "description": "TypeScript Domain client SDK for TKWF — GraphQL / REST transport, RPC proxy, session management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoongBa/tkwf-tsclient.git"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.0.0",
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/query-core": "5.102.8",
    "graphql": "^17.0.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
